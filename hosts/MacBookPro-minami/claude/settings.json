{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "nix *",
      "darwin-rebuild *",
      "nh *",
      ", *",
      "comma *",
      "docker *",
      "gh *",
      "terraform *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git clone *",
      "git ls-remote *",
      "git init *",
      "uv init *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache/uv",
        "~/Library/Caches/pip",
        "~/Library/Caches/deno"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/editorconfig-check.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a\\033]9;Claude Code needs your input\\007' 2>/dev/null > /dev/tty || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "langfuse-observability@langfuse-observability": true
  },
  "extraKnownMarketplaces": {
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    }
  },
  "language": "japanese",
  "pluginConfigs": {
    "langfuse-observability@langfuse-observability": {
      "options": {
        "LANGFUSE_BASE_URL": "http://localhost:3000"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark"
}
